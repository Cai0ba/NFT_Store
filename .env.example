# Liga a camada de mocks (MSW). Mantenha "true" no build de demonstração.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST. Com mocks ativos, as rotas são interceptadas pelo MSW.
VITE_API_URL=/api
# Endpoint Socket.IO. Com mocks ativos, a conexão é interceptada pelo MSW.
VITE_SOCKET_URL=wss://realtime.kurio.test
# Cenário inicial dos mocks (veja README > Cenários).
VITE_MOCK_SCENARIO=default
